{
  "manifest_version": 3,
  "name": "Nowser",
  "version": "1.0.0",
  "description": "Route traffic through your VPS and measure precise server-side timing",
  "permissions": [
    "proxy",
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "devtools_page": "devtools.html",
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  }
}
